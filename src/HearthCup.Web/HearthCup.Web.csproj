<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>HearthCup.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HearthCup.Models/HearthCup.Models.csproj" />
    <ProjectReference Include="../HearthCup.Utility/HearthCup.Utility.csproj" />
    <ProjectReference Include="../HearthCup.DataAccess/HearthCup.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: lets 'dotnet ef migrations' build the host without shipping the tools package. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data/catalogue.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
