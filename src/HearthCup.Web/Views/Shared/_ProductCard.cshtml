@model ProductCard
<article class="product-card"><a class="product-picture" asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id"><img src="@Model.ImageUrl" alt="@Model.Colour @Model.Material @Model.Category.ToLower()" loading="lazy" width="600" height="600"/>@if(Model.Stock==0){<span class="product-tag sold-out">Taking a little rest</span>}else if(Model.Id<=2){<span class="product-tag">For everyday moments</span>}<span class="picture-arrow" aria-hidden="true">↗</span></a><div class="card-meta"><span>@Model.Material · @Model.CapacityMl ml</span><span>@Model.Colour</span></div><div class="card-title"><h3><a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3><strong>@Model.Price.ToString("C")</strong></div><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/><button class="add-button" type="submit" disabled="@(Model.Stock==0)">@(Model.Stock==0?"Out of stock":"Add to basket") <span aria-hidden="true">+</span></button></form></article>
