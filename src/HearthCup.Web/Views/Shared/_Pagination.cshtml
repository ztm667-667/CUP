@model BrowseView
@if(Model.Catalogue.Pages>1){<nav class="pagination" aria-label="Product pages">@for(var pageNumber=1;pageNumber<=Model.Catalogue.Pages;pageNumber++){<a asp-action="@(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"?"Shop":"Index")" asp-route-Page="@pageNumber" asp-route-Q="@Model.Query.Q" asp-route-Category="@Model.Query.Category" asp-route-Material="@Model.Query.Material" asp-route-InStock="@Model.Query.InStock" asp-route-Sort="@Model.Query.Sort" class="@(pageNumber==Model.Catalogue.Page?"current":"")" aria-label="Page @pageNumber" aria-current="@(pageNumber==Model.Catalogue.Page?"page":null)">@pageNumber</a>}</nav>}
