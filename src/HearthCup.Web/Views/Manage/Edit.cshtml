@model ProductInput
@{var editing=ViewData["Id"] is int;ViewData["Title"]=editing?"Edit cup":"Add a new cup";}
<section class="container page-section"><a class="back-link" asp-action="Index">← Back to collection</a><p class="eyebrow">BEHIND THE COUNTER</p><h1>@ViewData["Title"]</h1><div class="editor-layout"><form asp-action="@(editing?"Edit":"Create")" asp-route-id="@ViewData["Id"]" method="post" class="editor-form">@if(!ViewData.ModelState.IsValid){<div class="validation" role="alert"><ul>@foreach(var issue in ViewData.ModelState.Values.SelectMany(v=>v.Errors)){<li>@issue.ErrorMessage</li>}</ul></div>}<input asp-for="Version" type="hidden"/><div class="field full"><label asp-for="Name">Cup name</label><input asp-for="Name" required minlength="2" maxlength="80"/></div><div class="field"><label asp-for="Category">Category</label><select asp-for="Category">@foreach(var c in CupOptions.Categories){<option>@c</option>}</select></div><div class="field"><label asp-for="Material">Material</label><select asp-for="Material">@foreach(var c in CupOptions.Materials){<option>@c</option>}</select></div><div class="field"><label asp-for="Colour">Colour</label><select asp-for="Colour">@foreach(var c in CupOptions.Colours){<option>@c</option>}</select></div><div class="field"><label asp-for="CapacityMl">Capacity (ml)</label><input asp-for="CapacityMl" type="number" min="50" max="2000" required/></div><div class="field"><label asp-for="Price">Price (£)</label><input asp-for="Price" type="number" min="0.50" max="999.99" step="0.01" required/></div><div class="field"><label asp-for="Stock">Stock</label><input asp-for="Stock" type="number" min="0" max="9999" required/></div><div class="field full"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="5" required minlength="10" maxlength="1200"></textarea></div><div class="field full"><label asp-for="Design">Product image</label><select asp-for="Design" id="designSelect">@foreach(var c in CupOptions.Designs){<option value="@c">@(c.StartsWith("amazon-") ? "Amazon photo: " + c[7..].ToUpperInvariant() : c.Replace("-"," "))</option>}</select><span class="small-print">Choose a saved local photo or an original illustration.</span></div><div class="form-actions full"><button type="submit" class="button">Save cup</button><a asp-action="Index">Cancel</a></div></form><aside class="editor-preview"><img id="designPreview" src="@(Model.Design.StartsWith("amazon-") ? "/images/products/" + Model.Design[7..] + ".jpg" : "/images/" + Model.Design + ".svg")" alt="Selected cup illustration"/><p>A small detail. A warmer home.</p></aside></div></section>
