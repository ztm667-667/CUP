@model ProductCard
@{ViewData["Title"]=Model.Name;}
<div class="container detail-wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">Home</a><span>/</span><a asp-action="Shop" asp-route-Category="@Model.Category">@Model.Category</a><span>/</span><span>@Model.Name</span></nav><section class="detail"><div class="detail-art"><img src="@Model.ImageUrl" alt="@Model.Colour @Model.Name"/></div><div class="detail-copy"><p class="eyebrow">A LITTLE EVERYDAY COMFORT</p><h1>@Model.Name</h1><p class="detail-price">@Model.Price.ToString("C")</p><p class="intro">@Model.Description</p><dl class="specs"><div><dt>Material</dt><dd>@Model.Material</dd></div><div><dt>Capacity</dt><dd>@Model.CapacityMl ml</dd></div><div><dt>Colour</dt><dd>@Model.Colour</dd></div><div><dt>Style</dt><dd>@Model.Category</dd></div></dl><p class="stock @(Model.Stock==0?"no-stock":"")">● @(Model.Stock>0?$"Ready for your home · {Model.Stock} in stock":"Out of stock for now")</p><form asp-controller="Cart" asp-action="Add" method="post" class="detail-buy"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><div><label for="quantity">Quantity</label><input id="quantity" type="number" name="quantity" value="1" min="1" max="@Math.Max(1,Math.Min(Model.Stock,99))" required disabled="@(Model.Stock==0)"/></div><button class="button" type="submit" disabled="@(Model.Stock==0)">@(Model.Stock>0?"Make it yours · Add to basket":"Out of stock")</button></form><p class="small-print">Made for everyday rituals. No real purchase is taken on this coursework store.</p>@if(Model.Design.StartsWith("amazon-")){<p class="small-print source-note">Product reference: <a href="https://www.amazon.co.uk/dp/@(Model.Design[7..].ToUpperInvariant())" target="_blank" rel="noopener noreferrer">Amazon UK ↗</a> · checked 20 October 2026.<br/>Saved reference price; availability shown is this shop's own demo inventory.</p>}</div></section></div>
